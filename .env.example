# --------------------------------------------------------------------------
# ClipMind AI — environment configuration
# Copy to `.env.local` and fill in the values before running the app.
# --------------------------------------------------------------------------

# Public base URL, used for canonical URLs, sitemap and OpenGraph metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign session cookies (HMAC-SHA256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default: 7 days).
AUTH_SESSION_MAX_AGE="604800"

# The one shared secret that gates entry to the whole app. There is no
# per-user password, registration, or social sign-in — entering this on the
# login screen creates a brand-new, blank workspace. Required in production.
SITE_PASSPHRASE="replace-me"

# --------------------------------------------------------------------------
# Database (Prisma, Postgres). Locally, point this at any reachable Postgres
# (e.g. a free Neon project) — there is no embedded/file-based fallback.
#
# DATABASE_URL_UNPOOLED is used only by `prisma migrate deploy`, which needs a
# direct (non-pooled) connection. Vercel's Neon integration sets both of these
# for you automatically. On a plain Postgres with no pooler in front (Railway,
# a local install), set DATABASE_URL_UNPOOLED to the same value as DATABASE_URL.
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# --------------------------------------------------------------------------
# Media storage. Local disk by default (STORAGE_DIR) — fine for local dev and
# for persistent-container hosts like Railway. On Vercel (serverless, no
# persistent disk) set BLOB_READ_WRITE_TOKEN instead; when set, it takes over
# from STORAGE_DIR automatically.
# --------------------------------------------------------------------------
STORAGE_DIR="./storage"
BLOB_READ_WRITE_TOKEN=""

# --------------------------------------------------------------------------
# AI pipeline. Optional — without any key the pipeline still produces real
# clips from audio analysis. A key upgrades quality (transcript + smart pick).
#
# RECOMMENDED (free): a single Groq key powers BOTH transcription (Whisper) and
# clip selection (Llama) through Groq's free, OpenAI-compatible API.
#   → get one at https://console.groq.com  (no card required)
# --------------------------------------------------------------------------
GROQ_API_KEY=""

# Paid alternatives (used only if GROQ_API_KEY is empty):
#   OpenAI  — Whisper transcription
#   Anthropic — Claude viral-moment selection
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --------------------------------------------------------------------------
# Billing (Stripe). When unset, billing runs in display-only mode and any
# checkout attempt returns a clear "not configured" error. Use test keys.
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ids for the paid plans (create them in the Stripe dashboard).
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_STUDIO=""
